{
  "name": "lumen-tex",
  "productName": "Lumen TeX",
  "version": "1.2.1",
  "description": "Éditeur LaTeX moderne avec aperçu PDF en direct",
  "main": "./out/main/index.js",
  "author": "Lucas Henocq",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --publish never --config.directories.output=release",
    "pack": "electron-vite build && electron-builder --mac dir",
    "pack:win": "electron-vite build && electron-builder --win dir",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never --config.directories.output=release",
    "dist:win": "electron-vite build && electron-builder --win nsis --config.directories.output=release --publish never",
    "release:win": "npm run dist:win && gh release create v%npm_package_version% release/Lumen-TeX-Setup-%npm_package_version%.exe release/Lumen-TeX-Setup-%npm_package_version%.exe.blockmap release/latest.yml --repo LucasHenocq/LumenTEX --target main --title %npm_package_version% --notes-file build/release-notes.md --generate-notes"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "codemirror": "^6.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "katex": "^0.18.9",
    "lib0": "^0.2.119",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "hyperswarm": "^4.17.2"
  }
}
